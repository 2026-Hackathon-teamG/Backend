# 이 파일을 .env.local 로 복사해서 값을 바꾸세요. (.env.local 은 git에 올라가지 않음)

# 개발 서버가 /api 요청을 넘길 백엔드 주소 (npm run dev / preview 전용)
API_PROXY_TARGET=http://localhost:8000

# 데이터 모드: auto(백엔드 시도 → 실패하면 목업) | live | mock
VITE_DATA_MODE=auto

# 빌드 결과물을 백엔드와 다른 주소에서 서빙할 때만 지정 (비우면 같은 주소의 /api 사용)
VITE_API_BASE=

# 폴링 간격(ms), 목업 재생 속도(ms)
VITE_POLL_MS=1000
VITE_MOCK_STEP_MS=900
